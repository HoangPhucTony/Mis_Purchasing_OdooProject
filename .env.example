# Biến môi trường cho container Odoo (Dockerfile).
# Trên Hugging Face Spaces: khai báo trong Settings -> Variables and secrets.

DB_HOST=db
DB_PORT=5432
DB_USER=odoo
DB_PASSWORD=change-me

# Mật khẩu quản trị Database Manager (/web/database/manager).
# BẮT BUỘC đặt giá trị mạnh khi deploy public.
ODOO_MASTER_PASSWORD=change-me

# Regex lọc database hiển thị (ví dụ: ^OdooProject$)
DB_FILTER=.*

# Số luồng chạy cron (scheduler khuyến mãi, làm mới tồn kho cửa hàng). 0 = tắt.
MAX_CRON_THREADS=1
