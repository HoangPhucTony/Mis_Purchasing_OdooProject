<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tồn kho/tốc độ bán thay đổi liên tục nên các chỉ số lưu trữ của định mức cửa hàng cần làm mới định kỳ -->
        <record id="ir_cron_store_product_line_refresh" model="ir.cron">
            <field name="name">Cửa hàng: Làm mới chỉ số tồn kho &amp; tốc độ bán</field>
            <field name="model_id" ref="model_store_product_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_stock_metrics()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
